package main;

public class Main {
    public static void main(String[] args) {
        System.out.println("--- 1. Print message a fixed number of times ---");
        int x = 2;
        while (x <= 6) {
            System.out.println("Let me Go!");
            x++;
        }

        System.out.println("\n--- 2. Numbers from 1 to 50 ---");
        int a = 1;
        while (a <= 50) {
            System.out.print(a + " ");
            a++;
        }

        System.out.println();
        System.out.println("\n--- 3. Numbers incremented by 4 (2, 6, 10... 50) ---");
        int b = 2;
        while (b <= 50) {
            System.out.print(b + " ");
            b = b + 4;
        }

        System.out.println();
        System.out.println("\n--- 4. Sum of the series (4 to 50) ---");
        int sum = 0;
        int i = 4;
        while (i <= 50) {
            sum = sum + i;
            i = i + 4;
        }

        System.out.println("Sum is: " + sum);
    }
}
